            else if(this.emoji) { ctx.font = `${36 * this.scale}px Arial`; ctx.fillText(this.emoji, -18, 18); } 
            else { ctx.fillStyle = this.color; ctx.fillRect(-12, -3, 24, 6); } 
            ctx.restore(); 
        }
