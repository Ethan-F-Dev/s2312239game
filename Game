    }
    function castRecover(p) { if(p.cd.recover > 0 || p.hp <= 0) return; playSkillSound(8888, "s1"); p.cd.recover = 45000; p.heal(p.maxHp * 0.05); }
    // 1. 音效管理系統 (新增)
    // ==========================================
    const audioCache = {}; // 音效快取池
    function playSkillSound(charId, skillName) {
        const soundUrl = "https://cdn.jsdelivr.net/gh/s2312239-sketch/s2312239AudioDatabase@main/sounds/char"+String(charId)+"_"+skillName+".mp3"
        if (!audioCache[soundUrl]) {
            audioCache[soundUrl] = new Audio(soundUrl);
            if(skillName === "s3"){
                audioCache[soundUrl].volume = 1.0; // 設定音量 大件100%
            }else{
                audioCache[soundUrl].volume = 0.5; // 設定音量 50%
            }
        }
        const audio = audioCache[soundUrl];
        audio.currentTime = 0;
        audio.play().catch(err => console.log("音效播放失敗(可能是瀏覽器限制):"+soundUrl, err));
    }
    let currentGameMode = 'normal';
    window.onload = function() {
        const modeButtons = document.querySelectorAll('.mode-btn');
        const gameModeOverlay = document.getElementById('game-mode');
        
        // FORCE the menu to be fully visible and active right away on load
        if (gameModeOverlay) {
            gameModeOverlay.style.display = "flex";
            gameModeOverlay.style.opacity = "1";
            gameModeOverlay.style.visibility = "visible";
            gameModeOverlay.style.transition = "opacity 0.4s ease, visibility 0.4s";
        }

        modeButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Remove 'selected' from all buttons, add to this one
                modeButtons.forEach(btn => btn.classList.remove('selected'));
                button.classList.add('selected');
                
                // Update the currentGameMode variable based on the clicked button's ID
                if (button.id === 'btn-mode-sf') {
                    currentGameMode = 'sf';
                } else {
                    currentGameMode = 'normal';
                }
                console.log("Current Game Mode set to:", currentGameMode);
            
                // Fade out the overlay smoothly
                setTimeout(() => {
                    gameModeOverlay.style.opacity = "0";
                    gameModeOverlay.style.visibility = "hidden";
                
                    // Completely hide after transition completes
                    setTimeout(() => {
                        gameModeOverlay.style.display = "none";
                    }, 400); 
                }, 300);
            });
        });

        // Keep your original game initialization functions untouched
        resize();
        renderMenu(1); 
        renderMenu(2);
        bindButtons();
        
        const startBtn = document.getElementById('start-btn');
        if(startBtn) {
            startBtn.onclick = startGame;
            startBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startGame(); });
        }
        
        const restartBtn = document.getElementById('restart-btn');
        if(restartBtn) {
            const handleRestart = (e) => {
                if (e) e.preventDefault();
                
                // FORCE the game mode screen to reappear when restarting
                if (gameModeOverlay) {
                    gameModeOverlay.style.display = "flex";
                    setTimeout(() => {
                        gameModeOverlay.style.opacity = "1";
                        gameModeOverlay.style.visibility = "visible";
                    }, 10);
                }
                
                // Run your original backToMenu logic
                backToMenu();
            };

            restartBtn.onclick = handleRestart;
            restartBtn.addEventListener('touchstart', handleRestart);
        }
        window.addEventListener('resize', resize);
    };
})();


