                  p.addShield(400);
                  shakeAmount = 40;
                }
                else if(dist(p, enemy) > 200 && dist(p, enemy) <= 300){
                  enemy.takeDamage(1000);
                  p.applyStatus("chill", 6500)
                  p.addShield(300);
                  shakeAmount = 30;
                }
                else if(dist(p, enemy) > 300 && dist(p, enemy) <= 500){
                  enemy.takeDamage(800);
                  p.applyStatus("chill", 5000)
                  p.addShield(200);
                  shakeAmount = 20
                }
                else if(dist(p, enemy) > 500){
                  enemy.takeDamage(500);
                  p.applyStatus("chill", 3000)
                  shakeAmount = 10
                }
             }
                ,0)

                setGameTimeout(()=> p.aWave = false,1200)

               }
               else{
                 floatTexts.push(new FloatText(p.x, p.y - 80, "你仍足夠冷靜，無法開啓大技能", "white"));
                p.cd.s3 = 0; return;
               }
         }else if (p.charIdx === 27) { // 康絲特斯 (Constance) S3: 魅力四射
            p.consS3Active = true;
            p.consS3Timer = 8000; // 範圍持續 8 秒
            
