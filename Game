             p.addShield(250);
             let wave = 0;
             let wi = setGameInterval(() => {
                 wave++;
                 if(p.fightStacks <= 4){
                if(wave == 1){
                p.applyStatus("superArmor", 2400);   
                }
                 else if(wave <= 21) {
                     // 3 waves
                    p.activeWarning = { type:'rect', l: 180, h: 100, color:'rgba(2, 94, 0, 1)'}; setGameTimeout(() => { if(dist(p, enemy) < 180) {p.heal(30);enemy.takeDamage(50, 1);shakeAmount=12; if(p.shiliLifelineActive) p.heal(100*0.8); } p.activeWarning = null; }, 100); 
                 } else {
                     // Explosion
                     clearInterval(wi); p.activeWarning = null;
                     p.activeWarning = { type:'circle', r:185, color:'rgba(2, 94, 0, 1)' }; if (dist(p, p.target) < 185){p.target.applyStatus('stunned', 1500 + 100 * p.fightStacks);}p.fightStacks = 1;p.fightingState = false;
                     floatTexts.push(new FloatText(p.x, p.y - 80, "怒吼！", "green"));
                 }
                }
                else if(p.fightStacks > 4){
                if(wave == 1){
                p.applyStatus("superArmor", 4200);   
                floatTexts.push(new FloatText(p.x, p.y - 80, "腎上腺素飆升！", "red"));
                }
                 else if(wave <= 36) {
                     // 3 waves
                    p.activeWarning = { type:'rect', l: 180, h: 100, color:'rgba(2, 94, 0, 1)'}; setGameTimeout(() => { if(dist(p, enemy) < 180) {p.heal(35);enemy.takeDamage(50, 1);shakeAmount=12; if(p.shiliLifelineActive) p.heal(100*0.8); } p.activeWarning = null; }, 100); 
                 } else {
                     // Explosion
                     clearInterval(wi); p.activeWarning = null;
                     p.activeWarning = { type:'circle', r:185, color:'rgba(2, 94, 0, 1)' }; if (dist(p, p.target) < 185){p.target.applyStatus('stunned', 2000 + 100 * p.fightStacks);}p.fightStacks = 2;p.fightingState = false;
                     floatTexts.push(new FloatText(p.x, p.y - 80, "狂戰士怒吼！", "red"));
                 }
                }
             }, 120);
             return;}, 750)
        }
        else if(p.charIdx === 20){
            if(p.holdBall == false){
              p.addShield(200)
              if(p.jlauPerformance < 3){
                p.jLauUlt = true;
                p.jlauPerformance = 3
                for(let i=0; i<12; i++) {particles.push(new Particle(p.x, p.y, "orange", "normal", "🤩", 42.5))}
                setGameTimeout(()=> {p.jlauPerformance = 3;p.jLauUlt = false}, 10000)
              } else if(p.jlauPerformance >= 3 && p.jlauPerformance < 5 ){
                 p.jlauPerformance =5
                 p.jLauUlt = true;
                for(let i=0; i<12; i++) {particles.push(new Particle(p.x, p.y, "orange", "normal", "🤩", 42.5))}
                setGameTimeout(()=> {p.jLauUlt = false; p.jlauPerformance = 3}, 10000)
              } else if(p.jlauPerformance == 5){
                p.jLauBuff = 1.5;
                p.jLauUlt = true;
                p.heal(300)
                setGameTimeout(()=> {p.jLauUlt = false; p.jLauBuff = 1}, 10000)
                for(let i=0; i<12; i++) {particles.push(new Particle(p.x, p.y, "orange", "normal", "🤩", 42.5))}
              }
            } else {
              p.applyStatus("superArmor", 5000)
              p.heal(380 * p.jlauPerformance);
              p.jlauPerformance = 2;
              for(let i=0; i<12; i++) {particles.push(new Particle(p.x, p.y, "orange", "normal", "🥳", 42.5))}
            }
        }

       else if(p.charIdx === 17){
                 let enemy = p.target;
                 if(p.cd.s1 > 0 && p.cd.s2 > 0 && p.hp < 1440){
                 p.aWave = true;
                 for(let i=0; i<250; i++) particles.push(new Particle(p.x, p.y, "orange", "normal", "🌊", 3.0, 5, 1000));
                p.heal(500);
                setGameTimeout(()=>
                {if(dist(p, enemy) < 100){
                  p.addShield(600);
                  enemy.takeDamage(1500);
                  p.applyStatus("chill", 10000)
                  shakeAmount = 50;
                  
                }
                else if(dist(p, enemy) > 100 && dist(p, enemy) <= 200){
                  enemy.takeDamage(1200);
