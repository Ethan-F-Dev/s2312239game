	if (p.charIdx === 35) {
                p.clovisMines.forEach(m => {
                    if (m.state === 'warning') {
                        ctx.save(); ctx.translate(m.x, m.y);
                        ctx.beginPath(); ctx.arc(0, 0, 100, 0, Math.PI * 2);
                        ctx.fillStyle = "rgba(255, 0, 0, 0.2)"; ctx.fill();
                        ctx.strokeStyle = "red"; ctx.stroke();
                        ctx.restore();
                    } else if (m.state === 'hidden') {
                        ctx.save(); ctx.translate(m.x, m.y);
                        ctx.beginPath(); ctx.arc(0, 0, 4, 0, Math.PI * 2);
                        ctx.fillStyle = "black"; ctx.fill();
                        ctx.restore();
                    }
