    class Particle {
        constructor(x, y, color, type='normal', emoji='', alpha=1.0, scale=1.0, speed=null, angle=null) { 
            this.x = x; this.y = y; this.color = color; 
            if(speed !== null && angle !== null) { this.vx = Math.cos(angle) * speed; this.vy = Math.sin(angle) * speed; } else { this.vx = (Math.random()-0.5)*12; this.vy = (Math.random()-0.5)*12; }
            this.life = 1.0; this.type = type; this.emoji = emoji; this.baseAlpha = alpha; this.scale = scale; 
            if (type === 'ash') { this.vx = (Math.random()-0.5)*8; this.vy = (Math.random()-1)*8; this.life = 2.0; this.color = "#888"; } 
        }
        update() { this.x += this.vx * timeScale; this.y += this.vy * timeScale; if(this.type === 'death' || this.type === 'ash') { this.vy -= 0.02 * timeScale; this.life -= 0.015 * timeScale; } else this.life -= 0.035 * timeScale; }
        draw() { ctx.save(); ctx.globalAlpha = Math.max(0, this.life * this.baseAlpha); if(this.emoji) { ctx.font = `${28 * this.scale}px Arial`; ctx.fillText(this.emoji, this.x - 14, this.y + 14); } else { ctx.fillStyle = this.color; ctx.fillRect(this.x, this.y, 4 * this.scale, 4 * this.scale); } ctx.restore(); }
    }
    class Projectile {
        constructor(x, y, angle, speed, color, dmg, owner, emoji='', scale=1, maxRange=null, onHit=null, hitOffset=20, isCluster=false, isWave=false, isTrap=false, penetrate=false) { 
            this.x = x; this.y = y; this.angle = angle; this.speed = speed; this.color = color; this.dmg = dmg; this.owner = owner; 
            this.emoji = emoji; this.life = 1.0; this.scale = scale; this.maxRange = maxRange; this.onHit = onHit; this.hitOffset = hitOffset; 
            this.traveled = 0; this.isCluster = isCluster; this.isWave = isWave; this.isTrap = isTrap; this.trapTick = 0; this.penetrate = penetrate;
            this.clusterOffsets = []; if(this.isCluster) { for(let i=0; i<50; i++) this.clusterOffsets.push({x: (Math.random()-0.5)*60, y: (Math.random()-0.5)*60}); } 
            this.hitTargets = [];
        }
        update() {
            if (this.isTrap) { this.life -= 0.0055 * timeScale; this.trapTick += 16 * timeScale; const enemy = this.owner.target; if(Math.hypot(this.x - enemy.x, this.y - enemy.y) < enemy.radius + 20) { if (this.trapTick >= 1000) { enemy.takeDamage(36, this.owner.charIdx); this.trapTick = 0; floatTexts.push(new FloatText(enemy.x, enemy.y - 60, "-36", "#ffff00")); } enemy.applyStatus('slow', 200); enemy.buffs.slow = Math.min(enemy.buffs.slow, 0.9); } return; }
	// Clovis Flying S2 Split
            if (this.isClovisFlyingS2) {
                this.splitTimer -= 16 * timeScale;
                if (this.splitTimer <= 0) {
                    this.life = 0;
                    for (let i = -2; i <= 2; i++) {
                        let splitAng = this.angle + i * 0.2;
                        let sDmg = 20 * (this.owner.clovisPassiveDamageBuff ? 1.3 : 1.0);
                        projectiles.push(new Projectile(this.x, this.y, splitAng, 18, "red", sDmg, this.owner, "🚀", 0.6));
                    }
                    return;
                }
            }
            // Jing Cha S1 split
            if (this.owner.charIdx === 13 && this.emoji === '🚀' && this.traveled > 300 && !this.hasSplit) { // Approx 1s if speed 300
                this.hasSplit = true; this.life = 0;
                for(let i=0; i<10; i++) {
                    let ang = this.angle - Math.PI/4 + (Math.PI/2 * (i/10));
                    projectiles.push(new Projectile(this.x, this.y, ang, 12, "blue", 50, this.owner, "", 0.5, 500, null, 15, false, false, false, false));
                }
                return;
            }
            const step = this.speed * timeScale; this.x += Math.cos(this.angle) * step; this.y += Math.sin(this.angle) * step; this.traveled += step;
            if (this.owner.charIdx === 11 && this.emoji === "🔥" && this.life > 0 && Math.random() < 0.3) { this.owner.marsFireZones.push({x: this.x, y: this.y, timer: 100}); }
            if(this.maxRange && this.traveled > this.maxRange) { this.life = 0; return; }
            const enemy = this.owner.target;
            if(Math.hypot(this.x - enemy.x, this.y - enemy.y) < enemy.radius + this.hitOffset) {
                if(this.penetrate) {
                    if(!this.hitTargets.includes(enemy.id)) {
                        let actualDmg = enemy.takeDamage(this.dmg, this.owner.charIdx);
                        if (this.owner.charIdx === 8 && enemy.wounds > 0) { enemy.wounds--; this.owner.heal(100); }
                        if (this.owner.charIdx === 26 && this.owner.yushanEnhanced) this.owner.heal((actualDmg.hpDmg + actualDmg.shieldDmg) * 0.2);
                        this.hitTargets.push(enemy.id);
                        if(this.onHit) this.onHit(enemy);
                    }
                } else {
                    let actualDmg = enemy.takeDamage(this.dmg, this.owner.charIdx);
                    if (this.owner.charIdx === 8 && enemy.wounds > 0) { enemy.wounds--; this.owner.heal(100); }
                    if (this.owner.charIdx === 26 && this.owner.yushanEnhanced) this.owner.heal((actualDmg.hpDmg + actualDmg.shieldDmg) * 0.2);
                    if (this.owner.charIdx === 1 && (enemy.hp / enemy.maxHp) < 0.5) { this.owner.heal((actualDmg.hpDmg + actualDmg.shieldDmg) * 0.4); }
                    if(this.owner.charIdx === 5 && this.owner.isJimingUlt) this.owner.jimingTotalDmg += actualDmg.hpDmg + actualDmg.shieldDmg;
                    if(this.owner.charIdx === 2 && !this.isWave) { this.owner.cd.s3 = Math.max(0, this.owner.cd.s3 - 1500); this.owner.heal(50); }
                    if (this.owner.charIdx === 13) { // Jing Cha S1 hit
                        if(this.emoji === '🚀') { enemy.applyStatus('slow', 2000); enemy.buffs.slow = 0.8; }
                    }
