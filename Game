                            this.owner.heal(200);
                            this.owner.shield += 200
                        }
                    }
                    if(this.onHit) this.onHit(enemy);
                    this.life = 0;
                }
            }
            if(this.x < -100 || this.x > width+100 || this.y < -100 || this.y > height+100) this.life = 0;
        }
