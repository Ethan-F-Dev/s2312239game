            }
	// Tolo (37) S3 Aura
            if (p.charIdx === 37 && p.tlS3Active) {
                ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(Date.now()/100);
                ctx.beginPath(); ctx.arc(0,0,100,0,Math.PI*2); ctx.fillStyle="rgba(128,128,128,0.3)"; ctx.fill();
