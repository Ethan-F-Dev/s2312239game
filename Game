            let name = "char-btn"
            let charSelected = Object.values(selDict).includes(i);
            if(currentGameMode === "sf"){
                if(charSelected){
                    const charChoosenOrder = Object.keys(selDict).find(charChoosenOrder => selDict[charChoosenOrder] === i);
