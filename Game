    function updateButtonCD(p, prefix) {
        ['s1', 's2', 's3', 'recover', 'atk'].forEach(k => {
            const el = document.getElementById(`${prefix}-btn-${k}`); if(!el) return;
            const txt = el.querySelector('.cd-text');
            
            let disabled = p.status.stunned > 0 || p.status.taunted > 0 || p.status.frozen > 0 || p.status.bound > 0 || (p.status.disarmed > 0 && k !== 'recover' && k !== 'atk') || (p.status.losegrip > 0 && k !== 'recover' && k !== 's1' && k !== 's2'  && k !== 's3');
            if (p.isCasting) {
                if (p.charIdx === 1 && p.taiS1Active && k === 'atk') disabled = false;
                else disabled = true;
            }
            if(p.charIdx === 3 && k === 's3' && (p.status.stunned > 0 || p.isLock)) disabled = true; 
            if(p.charIdx === 11 && k === 's3' && p.energy < 500) { disabled = true; txt.innerText = "❌"; }
            if(p.charIdx === 17 && k === 's3' && p.cd.s1 < 1 && p.cd.s2 < 1 && p.hp > 1440) { disabled = true; txt.innerText = "❌"; }
            if(p.charIdx === 27 && k === 'atk' && p.hp < 1000) disabled = true; // 康絲特斯血量低於1000無法普攻
            
            if (disabled) el.classList.add('disabled'); else el.classList.remove('disabled');
            if(p.cd[k] > 0) { txt.innerText = Math.ceil(p.cd[k]/1000); el.style.opacity = "0.4"; }
            else { txt.innerText = k==='recover'?'復':(k==='s3'?'終':(k==='atk'?'攻':k.slice(1))); el.style.opacity = "1"; }
        });
    }
    function bindButtons() {
        const setupJoy = (id, joyId, stickId, touchObj) => {
            const joy = document.getElementById(joyId), stick = document.getElementById(stickId);
            const move = (e) => {
                const t = e.targetTouches[0], rect = joy.getBoundingClientRect();
                let dx = t.clientX - (rect.left + rect.width/2), dy = t.clientY - (rect.top + rect.height/2);
                const dist = Math.min(55, Math.hypot(dx, dy)), angle = Math.atan2(id === 2 ? -dy : dy, id === 2 ? -dx : dx);
                stick.style.transform = `translate(${Math.cos(angle)*dist}px, ${Math.sin(angle)*dist}px)`;
                const la = Math.atan2(dy, dx); touchObj.joyX = Math.cos(la)*(dist/55); touchObj.joyY = Math.sin(la)*(dist/55);
            };
            joy.addEventListener('touchstart', (e) => { e.preventDefault(); move(e); });
            joy.addEventListener('touchmove', (e) => { e.preventDefault(); move(e); });
            joy.addEventListener('touchend', () => { stick.style.transform = `translate(0,0)`; touchObj.joyX = 0; touchObj.joyY = 0; });
        };
        const setupBtn = (id, type) => {
             const btn = document.getElementById(`p${id}-btn-${type}`); if(!btn) return;
             btn.addEventListener('touchstart', (e) => { 
                 e.preventDefault(); 
                 const p = (id === 1) ? p1 : p2; 
                 if (!p) return; 
                 if(p.isCasting && !(p.charIdx === 1 && p.taiS1Active && type === 'atk')) return;
                 if(type === 'atk') castAtk(p); 
                 else if(type === 's1') castS1(p); 
                 else if(type === 's2') castS2(p); 
                 else if(type === 's3') castS3(p); 
                 else if(type === 'recover') castRecover(p); 
             });
        };
        setupJoy(1, "p1-joy", "p1-stick", p1Touch); setupJoy(2, "p2-joy", "p2-stick", p2Touch);
        ['atk', 's1', 's2', 's3', 'recover'].forEach(t => { setupBtn(1, t); setupBtn(2, t); });
    }
    // --- Game Logic ---
    function checkMatchEnd() {
        if((p1.hp <= 0 || p2.hp <= 0) && !gameOver) {
            if(currentGameMode === "normal" || p1PlayProgress === 3 || p2PlayProgress === 3){
                playSkillSound(9998, 's1')
                gameOver = true;
                setGameTimeout(() => { 
                    document.getElementById('winner-text').innerText = (p1.hp > 0 ? "玩家 1" : "玩家 2") + " 獲勝！"; 
                    document.getElementById('game-over').style.display = 'flex'; 
                }, 2000);
            }else{
                if(p1.hp <= 0){
                    p1PlayProgress += 1
                }else{
                    p2PlayProgress += 1
                }
				startGame()
            }
        }
    }
    
    function startGame() {
        document.getElementById('menu').style.display = 'none';
        clearGameTimers(); resize();
        if(currentGameMode === "sf"){
            p1CharIdx = p1SelChar[p1PlayProgress]
            p2CharIdx = p2SelChar[p2PlayProgress]
        }
        p1 = new Player(1, p1CharIdx, width/2, height - 200); p2 = new Player(2, p2CharIdx, width/2, 200);
        p1.target = p2; p2.target = p1; gameRunning = true; gameOver = false; timeScale = 1.0; shakeAmount = 0; deathFocus = null;
        projectiles = []; particles = []; floatTexts = [];
        requestAnimationFrame(gameLoop);
    }
    function backToMenu() {
        gameRunning = false; clearGameTimers();
        document.getElementById('game-over').style.display = 'none'; document.getElementById('menu').style.display = 'flex';
        renderMenu(1); renderMenu(2);
    }
    function gameLoop() {
        if(!gameRunning) return;
        const dt = 16.6; p1.update(dt); p2.update(dt);
        [p1, p2].forEach(p => {
             const t = p.id === 1 ? p1Touch : p2Touch;
             if(!p.isLock && !p.isDying) { p.x += t.joyX * p.speed * p.buffs.speed; p.y += t.joyY * p.speed * p.buffs.speed; }
             
             // Forced movements (Taunt / Suction)
             if (!p.isUntouchable) {
                 if(p.status.taunted > 0 && p.tauntTarget) { 
                     let ang = Math.atan2(p.tauntTarget.y - p.y, p.tauntTarget.x - p.x); 
                     p.x += Math.cos(ang) * p.speed * 0.5; p.y += Math.sin(ang) * p.speed * 0.5; 
                 }
                 if(p.target.charIdx === 1 && p.target.taiS1Active && dist(p, p.target) < 300) {
                     p.x += (p.target.x - p.x) * 0.1; p.y += (p.target.y - p.y) * 0.3; // Suction 0.3
                 }
                 if(p.target?.charIdx === 12 && p.target?.skills?.s2?.active){}
             }
             
             // Mars S3 Flight
             if(p.charIdx === 11 && p.isMarsFlying) {
                  p.applyStatus("stunned", 500)
                  let distToTarget = dist(p, {x:p.ultTargetX, y:p.ultTargetY});
                  let step = 20 * timeScale;
                  if(distToTarget > step) {
                      let ang = Math.atan2(p.ultTargetY - p.y, p.ultTargetX - p.x);
                      p.x += Math.cos(ang) * step; p.y += Math.sin(ang) * step; 
                      particles.push(new Particle(p.x, p.y, "red", "normal", "", 0.5)); 
                  } else {
                      p.x = p.ultTargetX; p.y = p.ultTargetY;
                      p.isMarsFlying = false; p.isCasting = false; p.isUntouchable = false;
                      p.activeWarning = null;
                      let dmg = 300 + (p.energyConsumed / 100) * 85;
                      if(dist(p, p.target) < 250) { p.target.takeDamage(dmg, 11); p.target.applyStatus('stunned', 1000); }
                      shakeAmount = 40; for(let i=0; i<180; i++) particles.push(new Particle(p.x, p.y, "orange", "normal", "🔥", 3.0)); 
                      p.marsBuffTimer = 5000; 
                  }
             }
             if(p.charIdx === 10 && p.activeWarning && p.activeWarning.type === 'circle') { p.activeWarning.x = p.x; p.activeWarning.y = p.y; }
             
             p.x = Math.max(p.radius, Math.min(width - p.radius, p.x)); p.y = Math.max(p.radius, Math.min(height - p.radius, p.y));
        });
        projectiles.forEach(p => p.update()); projectiles = projectiles.filter(p => p.life > 0);
        particles.forEach(p => p.update()); particles = particles.filter(p => p.life > 0);
        floatTexts.forEach(t => t.update()); floatTexts = floatTexts.filter(t => t.life > 0);
        if(shakeAmount > 0) shakeAmount *= 0.85;
        draw(); updateButtonCD(p1, "p1"); updateButtonCD(p2, "p2");
        requestAnimationFrame(gameLoop);
    }
    function draw() {
        ctx.fillStyle = "#111"; ctx.fillRect(0,0,width,height); ctx.save();
        let cx = width/2, cy = height/2, zoom = 1.0;
        if(deathFocus) { zoom = 1.0; cx = deathFocus.x; cy = deathFocus.y; }
        ctx.translate(width/2, height/2); ctx.scale(zoom, zoom); ctx.translate(-cx, -cy);
        if(shakeAmount > 1) ctx.translate((Math.random()-0.5)*shakeAmount, (Math.random()-0.5)*shakeAmount);
        [p1, p2].forEach(p => {
	// Slime Link Line
            if (p.charIdx === 42 && p.slLinkTarget) {
                ctx.beginPath();
                ctx.moveTo(p.x, p.y); ctx.lineTo(p.slLinkTarget.x, p.slLinkTarget.y);
                ctx.strokeStyle = "rgba(50, 205, 50, 0.7)";
