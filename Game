                     p.ultBuff = 70;
                     p.hsUltPhase = 1;
                     p.activeWarning = null;
                     setGameTimeout(() => {if(p.ammo < 4){p.ammo = 4}; p.cd.s1 = 0; p.cd.s2 = 0;}, 0)
                } 
             }, 100);
             return;
            }
        }
        
        else if(p.charIdx === 16) {
            p.isCasting = true;
            floatTexts.push(new FloatText(p.x, p.y - 80, "正在飲用能量飲料...", "green"));
            setGameTimeout (() =>
            {
             p.isCasting = false;
