        // input: mode: "hand"/"auto", nomove: "on","off" (meaning if joystick no movement return auto angle or not), default off
        //output: angle/null/"wrong input"
        angleCalculate(mode, nomove="off"){
            let joy = this.id===1?p1Touch:p2Touch;
            if(mode === "hand" && nomove === "off"){
                if (Math.abs(joy.joyX) > 0.1 || Math.abs(joy.joyY) > 0.1){
                    return Math.atan2(joy.joyY, joy.joyX)
                }else{
                    return null
                }
            }else if(mode === "auto"){
                return this.angle
            }else{
                return"wrong input"
            }
        }
        //mode must be "hand"/"auto" , dist, time, rectW, rectH must be a number, 
        //warningColor must be a string 'color' or '', nomove defaulted "off", can be "on"
        //"on" means still dash when on joystick input
        //call by dash(mode, dist, time, warningColor, rectW, rectH, nomove)
        dash(mode, dist, time, warningColor,rectW, rectH, nomove){
            function getEasingFraction(durationMs, completionTarget = 0.99) {
                const frames = durationMs / 16; // Total frames during the timeout
                const remainingDistance = 1 - completionTarget; // e.g., 0.01 for 99%
                // Calculate the required fraction per frame
                return 1 - Math.pow(remainingDistance, 1 / frames);
            }
            if(nomove === "off" && (Math.abs(joy.joyX) <= 0.1 || Math.abs(joy.joyY) <= 0.1)){
                return null
            }
            let joy = this.id===1?p1Touch:p2Touch;
            let fraction = getEasingFraction(time)
            this.isCasting = true;
            this.activeWarning = { type:'rect', l:rectW, h:rectH, color: warningColor };
            let aimAngle = this.angle;
            if (Math.abs(joy.joyX) > 0.1 || Math.abs(joy.joyY) > 0.1 && mode === "hand") {
                aimAngle = Math.atan2(joy.joyY, joy.joyX);
                
            }
            let tx = this.x + Math.cos(aimAngle)*dist, ty = this.y + Math.sin(aimAngle)*dist; 
            let sInt = setGameInterval(() => { this.x += (tx - this.x)*fraction; this.y += (ty - this.y)*fraction; }, 16);
            setGameTimeout(() => {
                clearInterval(sInt);
                this.isCasting = false; 
                this.activeWarning = null;
            }, time);
        }
